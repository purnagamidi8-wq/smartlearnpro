# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smartlearn-pro

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=slp_token

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
EMAIL_FROM="SmartLearn Pro <no-reply@smartlearnpro.local>"

# Cloud storage (videos / thumbnails) - optional, app falls back to local /uploads if unset
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Proctoring risk weights (JSON) - optional override of server/config/proctoringConfig.js defaults
PROCTOR_RISK_WEIGHTS_JSON=
